# Frontend Environment Configuration Example
# Copy this file to .env.local for local overrides. Do NOT commit actual secrets.

# Backend API Base URL for Production Deployments:
# - Leave blank/omitted for local development (defaults to "/api" proxied by Vite to http://127.0.0.1:8000)
# - Set to full backend origin in decoupled production deployments, e.g.:
#   VITE_API_BASE_URL=https://diagnostic-recommender-api.onrender.com
VITE_API_BASE_URL=
